# Environment variables for ABF-GP application

# JWT Secret Key - REQUIRED for security
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-use-env-variable

# Server Port
PORT=3000

# Admin credentials (optional - default will be used if not set)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
